def api_get_settings():
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401
    settings = mutate(lambda d: dict(get_settings(d, user_id)))
    return jsonify(settings)


@web_app.route("/api/settings", methods=["POST"])
def api_set_settings():
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401
    body = request.get_json(force=True, silent=True) or {}

    def do(d):
        settings = get_settings(d, user_id)
        for key in ("receive", "notify", "show_seen"):
            if key in body:
                settings[key] = bool(body[key])
        return dict(settings)

    return jsonify(mutate(do))


@web_app.route("/api/blocked", methods=["GET"])
def api_blocked():
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401
    blocked = mutate(lambda d: list(d["blocks"].get(str(user_id), [])))
    items = [{"internal_id": i + 1, "ref": b} for i, b in enumerate(blocked)]
    return jsonify(items)


@web_app.route("/api/unblock", methods=["POST"])
def api_unblock():
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401
    body = request.get_json(force=True, silent=True) or {}
    ref = body.get("ref")

    def do(d):
        lst = d["blocks"].get(str(user_id), [])
        if ref in lst:
            lst.remove(ref)
        return True

    mutate(do)
    return jsonify({"ok": True})


@web_app.route("/api/conversations", methods=["GET"])
def api_conversations():
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401

    def do(d):
        out = []
        for conv_id, conv in d["conversations"].items():
            if user_id not in (conv["user_a"], conv["user_b"]):
                continue
            msgs = [m for m in d["messages"] if m["conversation_id"] == conv_id]
            if not msgs:
                continue
            last = msgs[-1]
            unread = sum(1 for m in msgs if m["recipient_id"] == user_id and m["status"] != "seen")
            out.append({
                "conversation_id": conv_id,
                "active": conv["active"],
                "last_message": last["content"],
                "last_status": last["status"],
                "unread": unread,
                "updated_at": last["created_at"],
            })
        out.sort(key=lambda x: x["updated_at"], reverse=True)
        return out

    return jsonify(mutate(do))


@web_app.route("/api/conversation/<conv_id>/messages", methods=["GET"])
def api_conversation_messages(conv_id):
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401

    def do(d):
        conv = d["conversations"].get(conv_id)
        if not conv or user_id not in (conv["user_a"], conv["user_b"]):
            return None
        msgs = [m for m in d["messages"] if m["conversation_id"] == conv_id]
        for m in msgs:
            if m["recipient_id"] == user_id and m["status"] != "seen":
                m["status"] = "seen"
                m["seen_at"] = time.time()
        return [
            {
                "id": m["id"],
                "mine": m["sender_id"] == user_id,
                "content": m["content"],
                "status": m["status"],
                "created_at": m["created_at"],
            }
            for m in msgs
        ]

    result = mutate(do)
    if result is None:
        return jsonify({"error": "not_found"}), 404
    return jsonify(result)


@web_app.route("/api/conversation/<conv_id>/reply", methods=["POST"])
def api_conversation_reply(conv_id):
    user_id = get_authed_user_id()
    if not user_id:
        return jsonify({"error": "unauthorized"}), 401
    body = request.get_json(force=True, silent=True) or {}
    content = (body.get("content") or "").strip()
    if not content:
        return jsonify({"error": "empty"}), 400

    def check(d):
        conv = d["conversations"].get(conv_id)
        if not conv or user_id not in (conv["user_a"], conv["user_b"]) or not conv["active"]:
            return "invalid"
        recipient_id = other_side(conv, user_id)
        if is_blocked(d, recipient_id, user_id):
            return "blocked"
        return "ok"

    status = mutate(check)
    if status != "ok":
        return jsonify({"error": status}), 400

    if MAIN_LOOP:
        future = asyncio.run_coroutine_threadsafe(
            send_anon_message(_dummy_context(), conv_id, user_id, content, is_reply=True),
            MAIN_LOOP,
        )
        try:
            future.result(timeout=10)
        except Exception as e:
            logger.error(f"api reply send failed: {e}")

    return jsonify({"ok": True})


class _dummy_context:
    """برای صدا زدن send_anon_message از خارج از یک آپدیت واقعی تلگرام."""
    def __init__(self):
        self.bot = _bot_ref


def run_web():
    web_app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8080)))


def keep_alive():
    t = threading.Thread(target=run_web, daemon=True)
    t.start()


