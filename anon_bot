async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    args = context.args

    if args and args[0].startswith("msg_"):
        token = args[0][4:]
        result = mutate(lambda d: d["tokens"].get(token))
        owner_id = result
        if not owner_id:
            await update.message.reply_text("❌ این لینک نامعتبر یا منقضی شده.")
            return
        if owner_id == user_id:
            await update.message.reply_text("🙃 نمی‌تونی به لینک خودت پیام بفرستی.")
            return

        def check(d):
            settings = get_settings(d, owner_id)
            if not settings.get("receive", True):
                return "disabled"
            if is_blocked(d, owner_id, user_id):
                return "blocked"
            return "ok"

        status = mutate(check)
        if status == "disabled":
            await update.message.reply_text("🚫 این کاربر فعلاً دریافت پیام ناشناس رو غیرفعال کرده.")
            return
        if status == "blocked":
            await update.message.reply_text("🚫 امکان ارسال پیام به این کاربر وجود نداره.")
            return

        context.user_data["anon_target"] = owner_id
        context.user_data["awaiting_anon_message"] = True
        await update.message.reply_text("✍️ پیامت رو بنویس (به صورت کاملاً ناشناس ارسال میشه):")
        return

    token = mutate(lambda d: get_or_create_link(d, user_id))
    link = f"https://t.me/{BOT_USERNAME}?start=msg_{token}" if BOT_USERNAME else f"(BOT_USERNAME تنظیم نشده) msg_{token}"
    text = (
        "👋 سلام!\n\n"
        "اینجا می‌تونی یک لینک ناشناس اختصاصی داشته باشی و دیگران بدون اینکه هویتشون معلوم بشه برات پیام بفرستن.\n\n"
        f"🔗 لینک ناشناس تو:\n{link}\n\n"
        "برای مدیریت پیام‌ها، تنظیمات و کاربران بلاک‌شده از دکمه‌ی زیر وارد Mini App شو."
    )
    await update.message.reply_text(text, reply_markup=start_menu_keyboard())


async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text or ""

    # ===== نوشتن پیام جدید =====
    if context.user_data.get("awaiting_anon_message"):
        context.user_data["awaiting_anon_message"] = False
        context.user_data["draft_message"] = text
        await update.message.reply_text(
            f"پیامت اینه:\n\n«{text}»\n\nمطمئنی می‌خوای ارسالش کنی؟",
            reply_markup=confirm_keyboard(),
        )
        return

    # ===== نوشتن پاسخ =====
    if context.user_data.get("awaiting_reply_conv"):
        conv_id = context.user_data.pop("awaiting_reply_conv")
        await send_anon_message(context, conv_id, user_id, text, is_reply=True)
        await update.message.reply_text("✅ پاسخ شما ارسال شد.")
        return

    # ===== نوشتن دلیل گزارش =====
    if context.user_data.get("awaiting_report_message_id"):
        message_id = context.user_data.pop("awaiting_report_message_id")

        def do_report(d):
            d["reports"].append({
                "id": str(uuid.uuid4()),
                "message_id": message_id,
                "reporter_id": user_id,
                "reason": text,
                "status": "pending",
                "created_at": time.time(),
            })

        mutate(do_report)
        await update.message.reply_text("✅ گزارش شما ثبت شد و توسط تیم پشتیبانی بررسی میشه.")
        return

    # ===== دستورات ادمین (فقط در چت خصوصی با ادمین) =====
    if user_id in ADMIN_IDS:
        if text.strip() == "reports":
            data = load_data()
            pending = [r for r in data["reports"] if r["status"] == "pending"]
            if not pending:
                await update.message.reply_text("گزارش در انتظاری وجود نداره.")
                return
            lines = [f"#{i+1} | دلیل: {r['reason']}" for i, r in enumerate(pending[:20])]
            await update.message.reply_text("🚩 گزارش‌های در انتظار:\n\n" + "\n".join(lines))
            return
        if text.startswith("block "):
            try:
                target = int(text.split()[1])
            except (IndexError, ValueError):
                await update.message.reply_text("فرمت درست: block <user_id>")
                return
            mutate(lambda d: d["blocks"].setdefault(str(user_id), []))
            await update.message.reply_text(f"کاربر {target} به لیست بلاک عمومی اضافه شد (فعلاً به صورت نمادین).")
            return


async def send_anon_message(context, conv_id, sender_id, content, is_reply):
    def prep(d):
        conv = d["conversations"][conv_id]
        recipient_id = other_side(conv, sender_id)
        if is_blocked(d, recipient_id, sender_id):
            return None
        if not check_rate_limit(d, sender_id):
            return "rate"
        if check_duplicate(d, conv_id, sender_id, content):
            return "duplicate"
        msg = {
            "id": str(uuid.uuid4()),
            "conversation_id": conv_id,
            "sender_id": sender_id,
            "recipient_id": recipient_id,
            "content": content,
            "status": "sent",
            "created_at": time.time(),
            "seen_at": None,
        }
        d["messages"].append(msg)
        return msg

    result = mutate(prep)
    if result in (None, "rate", "duplicate"):
        return result

    recipient_id = result["recipient_id"]
    keyboard = reply_received_keyboard(result["id"]) if is_reply else received_keyboard(result["id"])
    header = "📩 پاسخ به پیام ناشناس شما" if is_reply else "📩 پیام ناشناس جدید"
    try:
        await context.bot.send_message(
            recipient_id, f"{header}\n\n«{content}»", reply_markup=keyboard
        )
    except Exception as e:
        logger.error(f"send_anon_message failed: {e}")
    return result


async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    data_str = query.data
    user_id = query.from_user.id
    await query.answer()

    if data_str == "anon_confirm_send":
        content = context.user_data.pop("draft_message", None)
        target = context.user_data.pop("anon_target", None)
        if not content or not target:
            await query.edit_message_text("❌ پیام یافت نشد، دوباره امتحان کن.")
            return

        def make_conv(d):
            return get_conversation(d, user_id, target)

        conv_id, _ = mutate(make_conv)
        result = await send_anon_message(context, conv_id, user_id, content, is_reply=False)
        if result == "rate":
            await query.edit_message_text("⏳ تعداد پیام‌های شما در این بازه زیاده، کمی صبر کن.")
        elif result == "duplicate":
            await query.edit_message_text("⚠️ این پیام رو همین الان فرستادی.")
        elif result is None:
            await query.edit_message_text("🚫 امکان ارسال پیام به این کاربر وجود نداره.")
        else:
            await query.edit_message_text("✅ پیام ناشناس شما ارسال شد.")
        return

    if data_str == "anon_cancel_send":
        context.user_data.pop("draft_message", None)
        context.user_data.pop("anon_target", None)
        await query.edit_message_text("❌ لغو شد.")
        return

    if data_str == "anon_cancel_generic":
        await query.edit_message_text("❌ لغو شد.")
        return

    if data_str.startswith("anon_reply_"):
        message_id = data_str.replace("anon_reply_", "")
        mark_seen(message_id, user_id)
        conv_id = mutate(lambda d: next(
            (m["conversation_id"] for m in d["messages"] if m["id"] == message_id), None
        ))
        if not conv_id:
            await context.bot.send_message(user_id, "❌ این پیام دیگه در دسترس نیست.")
            return
        context.user_data["awaiting_reply_conv"] = conv_id
        await context.bot.send_message(user_id, "✍️ پاسخت رو بنویس:")
        return

    if data_str.startswith("anon_blockask_"):
        message_id = data_str.replace("anon_blockask_", "")
        mark_seen(message_id, user_id)
        sender_id = mutate(lambda d: next(
            (m["sender_id"] for m in d["messages"] if m["id"] == message_id), None
        ))
        if not sender_id:
            return
        await context.bot.send_message(
            user_id, "آیا می‌خواهید این فرستنده را بلاک کنید؟",
            reply_markup=block_confirm_keyboard(sender_id),
        )
        return

    if data_str.startswith("anon_blockyes_"):
        target_id = int(data_str.replace("anon_blockyes_", ""))

        def do_block(d):
            lst = d["blocks"].setdefault(str(user_id), [])
            if target_id not in lst:
                lst.append(target_id)
            conv_id, conv = get_conversation(d, user_id, target_id, create=False)
            if conv:
                conv["active"] = False

        mutate(do_block)
        await query.edit_message_text("✅ فرستنده بلاک شد.")
        return

    if data_str.startswith("anon_report_"):
        message_id = data_str.replace("anon_report_", "")
        mark_seen(message_id, user_id)
        context.user_data["awaiting_report_message_id"] = message_id
        await context.bot.send_message(user_id, "لطفاً دلیل گزارش رو بنویس:")
        return

    if data_str.startswith("anon_end_"):
        message_id = data_str.replace("anon_end_", "")

        def do_end(d):
            for m in d["messages"]:
                if m["id"] == message_id:
                    conv = d["conversations"].get(m["conversation_id"])
                    if conv:
                        conv["active"] = False
                    return

        mutate(do_end)
        await query.edit_message_text("🚫 گفتگو پایان یافت.")
        return


def mark_seen(message_id, viewer_id):
    def do(d):
        for m in d["messages"]:
            if m["id"] == message_id and m["recipient_id"] == viewer_id and m["status"] != "seen":
                m["status"] = "seen"
                m["seen_at"] = time.time()
                return m
        return None

    msg = mutate(do)
    if msg and MAIN_LOOP:
        def notify():
            data = load_data()
            settings = get_settings(data, msg["recipient_id"])
            if settings.get("show_seen", True):
                asyncio.run_coroutine_threadsafe(
                    _bot_ref.send_message(msg["sender_id"], "👁 پیام شما مشاهده شد."),
                    MAIN_LOOP,
                )
        notify()


# ================= اعتبارسنجی Telegram WebApp initData =================
def validate_init_data(init_data: str):
    if not init_data or not BOT_TOKEN:
        return None
    try:
        parsed = dict(parse_qsl(init_data, strict_parsing=True))
    except ValueError:
        return None
    received_hash = parsed.pop("hash", None)
    if not received_hash:
        return None
    data_check_string = "\n".join(f"{k}={v}" for k, v in sorted(parsed.items()))
    secret_key = hmac.new(b"WebAppData", BOT_TOKEN.encode(), hashlib.sha256).digest()
    computed_hash = hmac.new(secret_key, data_check_string.encode(), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(computed_hash, received_hash):
        return None
    user_raw = parsed.get("user")
    if not user_raw:
        return None
    try:
        return json.loads(user_raw)
    except Exception:
        return None


def get_authed_user_id():
    init_data = request.headers.get("X-Telegram-Init-Data", "")
    user = validate_init_data(init_data)
    if not user:
        return None
    return user.get("id")


