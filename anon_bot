_bot_ref = None  # بعد از ساخت اپلیکیشن پر میشه


async def post_init(application):
    global MAIN_LOOP, _bot_ref
    MAIN_LOOP = asyncio.get_running_loop()
    _bot_ref = application.bot
    logger.info("anon bot ready")


def main():
    if not BOT_TOKEN:
        raise RuntimeError("BOT_TOKEN تنظیم نشده (Environment Variables)")

    app = (
        ApplicationBuilder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .build()
    )
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_handler(CallbackQueryHandler(button_handler))

    keep_alive()
    app.run_polling()


