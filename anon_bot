# ================= ذخیره‌سازی (JSON) =================
def _default_data():
    return {
        "tokens": {},            # public_token -> user_id
        "user_token": {},        # user_id(str) -> public_token
        "conversations": {},     # conv_id -> {user_a, user_b, active}
        "messages": [],          # لیست پیام‌ها
        "blocks": {},            # blocker_id(str) -> [blocked_id, ...]
        "reports": [],           # گزارش‌ها
        "settings": {},          # user_id(str) -> {receive, notify, show_seen}
        "rate": {},              # user_id(str) -> [timestamps]
    }


def _supabase_headers():
    return {
        "apikey": SUPABASE_SERVICE_KEY,
        "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
        "Content-Type": "application/json",
    }


def load_data():
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        logger.error("SUPABASE_URL / SUPABASE_SERVICE_KEY تنظیم نشده؛ داده‌ی خالی برگردانده شد.")
        return _default_data()
    try:
        resp = requests.get(
            f"{SUPABASE_URL}/rest/v1/kv_store",
            params={"id": "eq.1", "select": "data"},
            headers=_supabase_headers(),
            timeout=10,
        )
        resp.raise_for_status()
        rows = resp.json()
        if rows and rows[0].get("data") is not None:
            return rows[0]["data"]
    except Exception as e:
        logger.error(f"load_data (supabase) failed: {e}")
    return _default_data()


def save_data(data):
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        return
    try:
        resp = requests.patch(
            f"{SUPABASE_URL}/rest/v1/kv_store",
            params={"id": "eq.1"},
            json={"data": data},
            headers={**_supabase_headers(), "Prefer": "return=minimal"},
            timeout=10,
        )
        resp.raise_for_status()
    except Exception as e:
        logger.error(f"save_data (supabase) failed: {e}")


def mutate(fn):
    """با قفل، دیتا رو میخونه، fn(data) رو صدا میزنه، ذخیره میکنه و نتیجه رو برمیگردونه."""
    with DATA_LOCK:
        data = load_data()
        result = fn(data)
        save_data(data)
        return result


def get_settings(data, user_id):
    return data["settings"].setdefault(
        str(user_id), {"receive": True, "notify": True, "show_seen": True}
    )


# ================= منطق پایه =================
def get_or_create_link(data, user_id):
    uid = str(user_id)
    token = data["user_token"].get(uid)
    if token and data["tokens"].get(token) == user_id:
        return token
    return regenerate_link(data, user_id)


def regenerate_link(data, user_id):
    uid = str(user_id)
    old_token = data["user_token"].get(uid)
    if old_token:
        data["tokens"].pop(old_token, None)
    new_token = secrets.token_urlsafe(9)
    data["tokens"][new_token] = user_id
    data["user_token"][uid] = new_token
    return new_token


def is_blocked(data, owner_id, other_id):
    blocked_list = data["blocks"].get(str(owner_id), [])
    return other_id in blocked_list


def get_conversation(data, user_a, user_b, create=True):
    key_pair = tuple(sorted([user_a, user_b]))
    for conv_id, conv in data["conversations"].items():
        if tuple(sorted([conv["user_a"], conv["user_b"]])) == key_pair:
            return conv_id, conv
    if not create:
        return None, None
    conv_id = str(uuid.uuid4())
    data["conversations"][conv_id] = {
        "user_a": user_a, "user_b": user_b, "active": True
    }
    return conv_id, data["conversations"][conv_id]


def check_rate_limit(data, sender_id):
    now = time.time()
    key = str(sender_id)
    stamps = [t for t in data["rate"].get(key, []) if now - t < RATE_LIMIT_WINDOW]
    if len(stamps) >= RATE_LIMIT_COUNT:
        data["rate"][key] = stamps
        return False
    stamps.append(now)
    data["rate"][key] = stamps
    return True


def check_duplicate(data, conv_id, sender_id, content):
    now = time.time()
    for m in reversed(data["messages"]):
        if m["conversation_id"] != conv_id or m["sender_id"] != sender_id:
            continue
        if now - m["created_at"] < DUPLICATE_WINDOW and m["content"] == content:
            return True
        break
    return False


def other_side(conv, user_id):
    return conv["user_b"] if conv["user_a"] == user_id else conv["user_a"]


